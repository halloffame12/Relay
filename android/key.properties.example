# Copy this file to android/key.properties and fill in real values.
# android/key.properties and the keystore are intentionally ignored by Git.
#
# storeFile is resolved relative to the android/ directory, or may be an
# absolute path written with forward slashes (for example,
# C:/Users/yourname/RelayKeys/relay-upload.jks).
# Keep the keystore and these values in a secure backup. If the upload key is
# lost, Google Play may require an upload-key reset before future updates.
storeFile=relay-upload.jks
storePassword=REPLACE_WITH_A_STRONG_PASSWORD
keyAlias=relay-upload
keyPassword=REPLACE_WITH_A_STRONG_PASSWORD
