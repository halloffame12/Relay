# Copy to .env and adjust. The service reads process environment; it does not
# parse this file itself, so use your platform's secret manager or
# `node --env-file=.env server.js`.
PORT=8080
WS_PATH=/v1/relay
ROOM_TTL_MS=600000
MAX_MESSAGE_BYTES=131072
MAX_MESSAGES_PER_MINUTE=120
MAX_CONNECTIONS_PER_IP=20
ALLOWED_ORIGINS=
STUN_URLS=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SECRET=
TURN_TTL_SECONDS=600
TRUST_PROXY=false
